{
	"name": "@fal-works/conceptual-model",
	"version": "0.1.0",
	"description": "Tiny toolkit for conceptual modeling.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"default": {
				"import": "./dist/index.js",
				"types": "./src/index.ts"
			}
		}
	},
	"files": [
		"dist/",
		"src/"
	],
	"scripts": {
		"build": "tsdown",
		"test": "node --test src/**/*.test.ts",
		"lint": "biome check src/",
		"lint:fix": "biome check --fix src/",
		"check:types": "tsc --noEmit -p tsconfig.json",
		"check": "npm run check:types && npm run lint",
		"fix": "npm run check:types && npm run lint:fix",
		"prebuild": "rimraf -g dist/*",
		"prepublishOnly": "npm run check:types && npm run lint && npm run test",
		"j2y": "node scripts/j2y.ts"
	},
	"keywords": [
		"JFG",
		"diagram"
	],
	"author": "FAL",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"yaml": "^2.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.2",
		"@types/node": "^24.1.0",
		"cac": "^6.7.14",
		"rimraf": "^6.0.1",
		"tsdown": "^0.13.0",
		"typescript": "^5.8.3"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fal-works/conceptual-model.git"
	},
	"homepage": "https://github.com/fal-works/conceptual-model#readme"
}