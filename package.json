{
	"name": "@fal-works/conceptual-model",
	"version": "0.1.0",
	"description": "Tiny toolkit for conceptual modeling: provides JSON schema (subset of JGF v2) and a converter to generate Mermaid class diagrams.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"bin": "./dist/bin.js",
	"files": [
		"dist/"
	],
	"scripts": {
		"setup": "deps-docs",
		"build": "npm run build:schema && npm run build:dist",
		"build:schema": "node scripts/build-schemas.ts && biome check docs/ src/ --fix",
		"build:dist": "tsdown",
		"test": "npm run test:unit && npm run test:integration",
		"test:unit": "node --test src/**/*.test.ts",
		"test:integration": "node --test test/**/*.test.ts",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"check:types": "tsc --noEmit -p tsconfig.json",
		"check:exports": "node scripts/check-unused-exports.ts",
		"check": "npm run check:types && npm run check:exports && npm run lint",
		"fix": "npm run check:types && npm run lint:fix",
		"pretest": "rimraf -g test-out/*",
		"prepublishOnly": "npm run check:types && npm run lint && npm run test",
		"j2y": "node scripts/j2y.ts",
		"y2j": "node scripts/y2j.ts"
	},
	"keywords": [
		"JFG",
		"diagram"
	],
	"author": "FAL",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"cac": "^6.7.14",
		"yaml": "^2.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.2",
		"@fal-works/deps-docs": "^0.1.0",
		"@types/node": "^24.1.0",
		"json-schema-to-ts": "^3.1.1",
		"rimraf": "^6.0.1",
		"ts-unused-exports": "^11.0.1",
		"tsdown": "^0.13.0",
		"typescript": "^5.8.3"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fal-works/conceptual-model.git"
	},
	"homepage": "https://github.com/fal-works/conceptual-model#readme"
}
